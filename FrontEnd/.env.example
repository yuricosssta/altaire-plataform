NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# URL usada pelo Next.js BFF (Rede Docker)
INTERNAL_API_URL=http://backend:3001
# URL da API de autenticação externa (server-side - Cazuá)
AUTH_API_URL=https://vanguarda-eight.vercel.app
# URL privada do backend NestJS (server-side, sobrescreve NEXT_PUBLIC_ em produção)
BACKEND_API_URL=
# Segredo JWT para re-encrypt de tokens no BFF (compartilhado com o NestJS)
JWT_SECRET=super-secret-jwt-key-change-in-production

# Credenciais de API Client para integração com o Cazuá
X-CLIENT-ID=
X-CLIENT-SECRET=
CAZUA_CLIENT_ID=
CAZUA_CLIENT_SECRET=

# Auth.js v5 (NextAuth) & Login Social Google OAuth (100% Gratuito)
AUTH_SECRET=super-secret-jwt-key-change-in-production
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Governança da Organização Padrão "Altaire" (separar múltiplos e-mails por vírgula)
# Qualquer outro e-mail cadastrado entra automaticamente como MEMBER isolado
ALTAIRE_OWNER_EMAILS=
ALTAIRE_ADMIN_EMAILS=