# Dockerfile.dev frontend para desenvolvimento com hot reload
FROM node:22-alpine
WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copia apenas arquivos de dependência primeiro (para aproveitar o cache)
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_INITIAL_MAP_CENTER
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_INITIAL_MAP_CENTER=$NEXT_PUBLIC_INITIAL_MAP_CENTER

# Usa cache mount do BuildKit para evitar redownload de pacotes a cada rebuild
RUN --mount=type=cache,id=pnpm-frontend,target=/pnpm/store pnpm install --frozen-lockfile

# Copia apenas os arquivos leves de configuração (src/ e public/ serão montados via volume)
COPY tsconfig.json next.config.ts next-env.d.ts postcss.config.mjs components.json ./

EXPOSE 3000

# Usa Turbopack (Rust nativo) e desativa source-maps para reduzir drasticamente o pico de CPU e RAM no Ctrl+S
CMD ["pnpm", "dev", "--turbopack", "--disable-source-maps"]
